#!/usr/bin/env zsh
#
# Update every tool on this machine that the system package manager does not
# own: Homebrew, the curl-installed toolchains, plain git clones, and the
# tarball / AppImage installs that ship no updater at all.
#
# Steps are independent -- one failure is reported and the rest still run.

emulate -L zsh
setopt no_unset

: ${ZSH:="$HOME/.oh-my-zsh"}
: ${NVM_DIR:="$HOME/.config/nvm"}

local_bin="$HOME/.local/bin"

step()  { print -P "%F{blue}==> $1%f" }
ok()    { print -P "%F{green}    $1%f" }
skip()  { print -P "%F{242}    $1%f" }
fail()  { print -P "%F{red}    $1%f" }

# -----------------------------------------------------------------------------
# Tools that know how to update themselves
# -----------------------------------------------------------------------------
run_self_updaters() {
    local cmd
    # omz is a shell function, not a binary, so drive its script directly.
    for cmd in \
        "brew update && brew upgrade" \
        "bun upgrade && bun update -g" \
        "uv self update && uv tool upgrade --all" \
        "rustup update && cargo install-update -a" \
        "juliaup self update && juliaup update" \
        "npm update -g" \
        "flatpak update -y" \
        "$ZSH/tools/upgrade.sh" \
        "claude update" \
        "codex update" \
        "copilot update" \
        "agy update" \
        "curl -fsSL https://zed.dev/install.sh | sh"
    do
        step "$cmd"
        eval "$cmd" || fail "failed: $cmd"
    done
}

# -----------------------------------------------------------------------------
# nvm is a git checkout; upstream says upgrade by checking out the latest tag.
# Node itself is deliberately left alone -- moving Node versions rebuilds the
# global package set and is a decision, not routine maintenance.
# -----------------------------------------------------------------------------
run_nvm() {
    step "nvm"
    [[ -d "$NVM_DIR/.git" ]] || { skip "not a git checkout"; return 0 }
    git -C "$NVM_DIR" fetch --tags --quiet \
        && git -C "$NVM_DIR" checkout --quiet \
            "$(git -C "$NVM_DIR" describe --abbrev=0 --tags)" \
        && ok "$(git -C "$NVM_DIR" describe --tags)" \
        || fail "failed: nvm"
}

# -----------------------------------------------------------------------------
# oh-my-zsh custom plugins and tmux plugins are plain clones nothing else
# updates. --ff-only so locally edited plugins fail loudly instead of merging.
# -----------------------------------------------------------------------------
run_git_plugins() {
    local repo
    for repo in "$ZSH"/custom/plugins/*/.git(N:h) "$HOME"/.tmux/plugins/*/.git(N:h); do
        step "${repo:t}"
        git -C "$repo" pull --ff-only --quiet || fail "failed: ${repo:t}"
    done
}

# -----------------------------------------------------------------------------
# Quarto ships as a tarball. /opt/quarto is user-owned, so no sudo needed.
# -----------------------------------------------------------------------------
run_quarto() {
    step "quarto"
    local latest current tmp extracted
    latest=$(curl -fsSL \
        "https://api.github.com/repos/quarto-dev/quarto-cli/releases/latest" \
        | grep -m1 '"tag_name"' | grep -oE '[0-9]+\.[0-9]+\.[0-9]+')
    current=$(quarto --version 2>/dev/null)
    [[ -n $latest ]] || { fail "could not read latest release"; return 1 }
    [[ $latest == $current ]] && { skip "quarto $current already current"; return 0 }

    tmp=$(mktemp -d) || return 1
    if curl -fL --progress-bar \
        "https://github.com/quarto-dev/quarto-cli/releases/download/v${latest}/quarto-${latest}-linux-amd64.tar.gz" \
        -o "$tmp/quarto.tar.gz" && tar -xzf "$tmp/quarto.tar.gz" -C "$tmp"
    then
        extracted=("$tmp"/quarto-*(N/))
        # Swap only once the new tree is verified on disk, so a failed
        # download can never leave /opt/quarto missing.
        if [[ -n ${extracted[1]:-} && -x ${extracted[1]}/bin/quarto ]]; then
            rm -rf /opt/quarto && mv "${extracted[1]}" /opt/quarto \
                && ok "quarto $current -> $latest" \
                || fail "failed to install quarto $latest"
        else
            fail "downloaded quarto $latest looks broken, keeping $current"
        fi
    else
        fail "failed to fetch quarto $latest"
    fi
    rm -rf "$tmp"
}

# -----------------------------------------------------------------------------
# AppImages: filename carries the version, so the newest release asset name
# tells us whether we already have it.
#   usage: run_appimage <label> <repo> <asset-regex> <cleanup-glob>
# -----------------------------------------------------------------------------
run_appimage() {
    local label=$1 repo=$2 pattern=$3 glob=$4
    step "$label"
    local url name old
    url=$(curl -fsSL "https://api.github.com/repos/$repo/releases/latest" \
        | grep -oE "https://github.com/[^\"]*${pattern}" | head -1)
    [[ -n $url ]] || { fail "no matching asset in $repo"; return 1 }

    name=${url:t}
    [[ -e "$local_bin/$name" ]] && { skip "$name already current"; return 0 }

    curl -fL --progress-bar "$url" -o "$local_bin/$name.part" \
        || { fail "download failed"; rm -f "$local_bin/$name.part"; return 1 }
    chmod +x "$local_bin/$name.part"
    mv "$local_bin/$name.part" "$local_bin/$name"
    for old in "$local_bin"/${~glob}(N); do
        [[ ${old:t} == $name ]] || rm -f "$old"
    done
    ok "installed $name"
}

run_self_updaters
run_nvm
run_git_plugins
run_quarto
run_appimage obsidian obsidianmd/obsidian-releases \
    'Obsidian-[0-9.]+\.AppImage' 'Obsidian-*.AppImage'
run_appimage logseq logseq/logseq \
    'Logseq-linux-x86_64-[0-9.]+\.AppImage' 'Logseq-linux-*.AppImage'
