# =============================================================================
# FUNCTIONS
# =============================================================================
y() {
  local tmp cwd
  tmp="$(mktemp -t yazi-cwd.XXXXXX)"
  yazi "$@" --cwd-file="$tmp"
  if cwd="$(cat -- "$tmp")" && [[ -n "$cwd" && "$cwd" != "$PWD" ]]; then
    builtin cd -- "$cwd"
  fi
  rm -f -- "$tmp"
}

c() {
    if [ -f "$1" ]; then
        builtin cd "$(dirname "$1")" && ls
    else
        builtin cd -P "$1" && ls
    fi
}
compdef _cd c

# =============================================================================
# ALIASES
# =============================================================================
# Core replacements
alias cat="bat"
alias ls="eza"
alias ll="eza -alh"

# Search & Preview
alias fdd="fd --hidden --no-ignore"
alias rgg="rg --hidden --no-ignore"
alias fzp="fzf --preview '([[ -f {} ]] && (bat --style=numbers --color=always {} || cat {})) || ([[ -d {} ]] && (tree -C {} | less)) || echo {} 2> /dev/null | head -200'"

# Package management
alias sysupapt="sudo apt update && sudo apt upgrade -y && sudo apt autoremove -y"
alias sysup="sudo zypper refresh && sudo zypper update"
alias sysclean="sudo zypper rm --clean-deps \$(sudo zypper packages --unneeded | awk '/^i/ {print \$5}')"
alias bunup="bun update -g"
alias uvup="uv tool upgrade --all"
alias cargoup="cargo install-update -a"
alias brewup="brew update && brew upgrade"
# toolsup is a standalone script: bin/.local/bin/toolsup

# System & UI
alias sk="sudo systemctl start keyd"
alias sx="startx /usr/bin/startplasma-x11"
alias sw="dbus-run-session startplasma-wayland"
alias sm="kwin_wayland_wrapper --xwayland"

# Utilities
alias e="gedit"
alias lg="lazygit"
alias tt="gio trash"
alias xc="xclip -selection clipboard"
alias myvpn='sudo wg-quick up wg0'
alias mc="COLORTERM=truecolor mc -S faybtheme"
alias lzd="lazydocker"

# Synchronization
alias pullvault="cd ~/DriveSyncFiles && rclone copy gdrive:DriveSyncFiles . --update --verbose --exclude '.obsidian/workspace.json' --exclude '.obsidian/workspace-mobile.json' --exclude '.obsidian/cache/**' --exclude '.trash/**'"
alias pushvault="cd ~/DriveSyncFiles && rclone copy . gdrive:DriveSyncFiles --update --verbose --exclude '.obsidian/workspace.json' --exclude '.obsidian/workspace-mobile.json' --exclude '.obsidian/cache/**' --exclude '.trash/**'"

# =============================================================================
# ENVIRONMENT & SETTINGS
# =============================================================================
export EDITOR='nvim'

if [[ -d "$HOME/.bookmarks" ]]; then
    export CDPATH=".:$HOME/.bookmarks:/"
fi

export FZF_DEFAULT_OPTS="--preview '([[ -f {} ]] && (bat --style=numbers --color=always {} || cat {})) || ([[ -d {} ]] && (tree -C {} | less)) || echo {} 2> /dev/null | head -200'"
export FZF_DEFAULT_COMMAND="fd --hidden --no-ignore"
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND="fd -t d --no-ignore"
export FZF_CTRL_R_OPTS="--preview 'echo {}' --preview-window down:3:hidden:wrap --bind '?:toggle-preview'"
export FZF_TMUX=1

set -o menucomplete
bindkey -M menuselect '^[[1;5C' forward-char
bindkey -M menuselect '^[[1;5D' backward-char