[user]
    name = fablackner
    email = 35771682+fablackner@users.noreply.github.com

[init]
    defaultBranch = main

[alias]
    # The Essentials
    st = status
    co = checkout
    ci = commit
    br = branch
    df = diff
    # Diff / Merge shortcuts
    dt = difftool
    mt = mergetool
    # Utilities
    unstage = reset HEAD --
    last = log -1 HEAD
    # Pretty Log (A graph view of your history)
    lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit

[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    side-by-side = true
    line-numbers = true

[diff]
    tool = meld
    colorMoved = default
    algorithm = histogram

[difftool]
    prompt = false

[merge]
    tool = kdiff3
    conflictstyle = zdiff3

[mergetool]
    prompt = false

[rerere]
    enabled = true

[push]
    autoSetupRemote = true

[fetch]
    prune = true

[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true