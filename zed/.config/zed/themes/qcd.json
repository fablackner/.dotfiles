// QCD Theme, ported from ~/projects/vscodeProjects/vscode-qcd-theme/themes/qcd.json.
// https://github.com/fablackner/vscode-qcd-theme
// Zed theme keys: https://zed.dev/schema/themes/v0.2.0.json
// Semantic token modifiers (bold declarations, italic globals) are set via
// "semantic_token_rules" in settings.json; the styles they reference live here.
{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "QCD Theme",
  "author": "fablackner",
  "themes": [
    {
      "name": "QCD Theme",
      "appearance": "dark",
      "style": {
        // Borders.
        "border": "#000000",
        "border.variant": "#000000",
        "border.focused": "#fce566",
        "border.selected": "#fce566",
        "border.transparent": "#00000000",
        "border.disabled": "#292629",

        // Surfaces.
        "background": "#141014",
        "surface.background": "#211421",
        "elevated_surface.background": "#211421",
        "drop_target.background": "#141014bf",
        "drop_target.border": "#fce566",

        // Buttons, inputs, and list items.
        "element.background": "#4a1a4a",
        "element.hover": "#003f2f",
        "element.active": "#461d51",
        "element.selected": "#461d51",
        "element.disabled": "#292629",
        "element.selection_background": "#56036b",
        "ghost_element.background": "#00000000",
        "ghost_element.hover": "#003f2f",
        "ghost_element.active": "#461d51",
        "ghost_element.selected": "#461d51",
        "ghost_element.disabled": "#00000000",

        // Text and icons.
        "text": "#c3c0b5",
        "text.muted": "#c3c0b5",
        "text.placeholder": "#8b8772",
        "text.disabled": "#767771",
        "text.accent": "#fce566",
        "icon": "#c3c0b5",
        "icon.muted": "#c3c0b5",
        "icon.placeholder": "#8b8772",
        "icon.disabled": "#767771",
        "icon.accent": "#fce566",
        "link_text.hover": "#5ad4e6",
        "debugger.accent": "#fc618d",

        // Workbench chrome.
        "title_bar.background": "#141014",
        "title_bar.inactive_background": "#141014",
        "status_bar.background": "#141014",
        "toolbar.background": "#1e181e",
        "tab_bar.background": "#141014",
        "tab.inactive_background": "#141014",
        "tab.active_background": "#211421",
        "panel.background": "#211421",
        "panel.focused_border": "#fce566",
        "panel.indent_guide": "#292629",
        "panel.indent_guide_hover": "#767771",
        "panel.indent_guide_active": "#767771",
        "panel.overlay_background": "#211421",
        "panel.overlay_hover": "#003f2f",
        "pane.focused_border": "#00000000",
        "pane_group.border": "#000000",

        // Scrollbar and minimap.
        "scrollbar.thumb.background": "#79797966",
        "scrollbar.thumb.hover_background": "#a6a6a666",
        "scrollbar.thumb.active_background": "#cecece66",
        "scrollbar.thumb.border": "#00000000",
        "scrollbar.track.background": "#141014",
        "scrollbar.track.border": "#00000000",
        "minimap.thumb.background": "#79797966",
        "minimap.thumb.hover_background": "#a6a6a666",
        "minimap.thumb.active_background": "#cecece66",
        "minimap.thumb.border": "#00000000",

        // Editor.
        "editor.foreground": "#c3c0b5",
        "editor.background": "#1e181e",
        "editor.gutter.background": "#211421",
        "editor.subheader.background": "#211421",
        "editor.active_line.background": "#211925",
        "editor.highlighted_line.background": "#211421",
        "editor.debugger_active_line.background": "#fce56633",
        "editor.line_number": "#c3c0b5",
        "editor.active_line_number": "#fce566",
        "editor.hover_line_number": "#c3c0b5",
        "editor.invisible": "#c3c0b5",
        "editor.wrap_guide": "#c3c0b5",
        "editor.active_wrap_guide": "#c3c0b5",
        "editor.indent_guide": "#211421",
        "editor.indent_guide_active": "#767771",
        "editor.document_highlight.read_background": "#c3c0b526",
        "editor.document_highlight.write_background": "#c3c0b526",
        "editor.document_highlight.bracket_background": "#141014",
        "search.match_background": "#ff7b00a1",
        "search.active_match_background": "#4b6153",

        // Diffs and version control.
        "editor.diff_hunk.added.background": "#7bd88f1a",
        "editor.diff_hunk.added.hollow_background": "#7bd88f0d",
        "editor.diff_hunk.added.hollow_border": "#7bd88f80",
        "editor.diff_hunk.deleted.background": "#fc618d1a",
        "editor.diff_hunk.deleted.hollow_background": "#fc618d0d",
        "editor.diff_hunk.deleted.hollow_border": "#fc618d80",
        "version_control.added": "#7bd88f",
        "version_control.deleted": "#fc618d",
        "version_control.modified": "#fd9353",
        "version_control.renamed": "#5ad4e6",
        "version_control.conflict": "#fd9353",
        "version_control.ignored": "#767771",
        "version_control.word_added": "#7bd88f33",
        "version_control.word_deleted": "#fc618d33",
        "version_control.conflict_marker.ours": "#fc618d19",
        "version_control.conflict_marker.theirs": "#7bd88f19",

        // Diagnostics and file status.
        "error": "#fc618d",
        "error.background": "#fc618d1a",
        "error.border": "#fc618d",
        "warning": "#fd9353",
        "warning.background": "#fd93531a",
        "warning.border": "#fd9353",
        "info": "#5ad4e6",
        "info.background": "#5ad4e61a",
        "info.border": "#5ad4e6",
        "hint": "#8b8772",
        "hint.background": "#8b87721a",
        "hint.border": "#8b8772",
        "success": "#7bd88f",
        "success.background": "#7bd88f1a",
        "success.border": "#7bd88f",
        "created": "#7bd88f",
        "created.background": "#7bd88f1a",
        "created.border": "#7bd88f",
        "deleted": "#fc618d",
        "deleted.background": "#fc618d1a",
        "deleted.border": "#fc618d",
        "modified": "#fce566",
        "modified.background": "#fce5661a",
        "modified.border": "#fce566",
        "conflict": "#fd9353",
        "conflict.background": "#fd93531a",
        "conflict.border": "#fd9353",
        "renamed": "#5ad4e6",
        "renamed.background": "#5ad4e61a",
        "renamed.border": "#5ad4e6",
        "ignored": "#767771",
        "ignored.background": "#7677711a",
        "ignored.border": "#767771",
        "hidden": "#767771",
        "hidden.background": "#7677711a",
        "hidden.border": "#767771",
        "predictive": "#767771",
        "predictive.background": "#7677711a",
        "predictive.border": "#767771",
        "unreachable": "#8b8772",
        "unreachable.background": "#8b87721a",
        "unreachable.border": "#8b8772",

        // Vim and Helix mode indicators.
        "vim.normal.background": "#fce566",
        "vim.normal.foreground": "#141014",
        "vim.insert.background": "#7bd88f",
        "vim.insert.foreground": "#141014",
        "vim.replace.background": "#fc618d",
        "vim.replace.foreground": "#141014",
        "vim.visual.background": "#8d81fe",
        "vim.visual.foreground": "#141014",
        "vim.visual_line.background": "#8d81fe",
        "vim.visual_line.foreground": "#141014",
        "vim.visual_block.background": "#8d81fe",
        "vim.visual_block.foreground": "#141014",
        "vim.helix_normal.background": "#fce566",
        "vim.helix_normal.foreground": "#141014",
        "vim.helix_select.background": "#8d81fe",
        "vim.helix_select.foreground": "#141014",
        "vim.helix_jump_label.foreground": "#fce566",
        "vim.yank.background": "#4b6153",

        // Integrated terminal. Dim colors are the base colors blended 60/40 with the background.
        "terminal.background": "#281528",
        "terminal.foreground": "#c3c0b5",
        "terminal.bright_foreground": "#c3c0b5",
        "terminal.dim_foreground": "#857c7d",
        "terminal.ansi.background": "#281528",
        "terminal.ansi.black": "#211421",
        "terminal.ansi.red": "#fc618d",
        "terminal.ansi.green": "#7bd88f",
        "terminal.ansi.yellow": "#fce566",
        "terminal.ansi.blue": "#fd9353",
        "terminal.ansi.magenta": "#948ae3",
        "terminal.ansi.cyan": "#5ad4e6",
        "terminal.ansi.white": "#c3c0b5",
        "terminal.ansi.bright_black": "#c3c0b5",
        "terminal.ansi.bright_red": "#fc618d",
        "terminal.ansi.bright_green": "#7bd88f",
        "terminal.ansi.bright_yellow": "#fce566",
        "terminal.ansi.bright_blue": "#fd9353",
        "terminal.ansi.bright_magenta": "#948ae3",
        "terminal.ansi.bright_cyan": "#5ad4e6",
        "terminal.ansi.bright_white": "#c3c0b5",
        "terminal.ansi.dim_black": "#241424",
        "terminal.ansi.dim_red": "#a74365",
        "terminal.ansi.dim_green": "#5a8a66",
        "terminal.ansi.dim_yellow": "#a7924d",
        "terminal.ansi.dim_blue": "#a86142",
        "terminal.ansi.dim_magenta": "#695b98",
        "terminal.ansi.dim_cyan": "#46889a",
        "terminal.ansi.dim_white": "#857c7d",

        // Rainbow brackets use VS Code's default bracket pair colors, which QCD does not override.
        "accents": ["#ffd700", "#da70d6", "#179fff"],

        // The first player is the local cursor and selection; the rest are collaborators.
        "players": [
          { "cursor": "#fce566", "background": "#fce566", "selection": "#56036b" },
          { "cursor": "#54fe50", "background": "#54fe50", "selection": "#54fe503d" },
          { "cursor": "#57e6ff", "background": "#57e6ff", "selection": "#57e6ff3d" },
          { "cursor": "#fe61fa", "background": "#fe61fa", "selection": "#fe61fa3d" },
          { "cursor": "#ff8040", "background": "#ff8040", "selection": "#ff80403d" },
          { "cursor": "#8d81fe", "background": "#8d81fe", "selection": "#8d81fe3d" }
        ],

        // Tree-sitter captures fall back to their longest defined prefix (e.g. "type.class.call" -> "type").
        // Semantic token rules look styles up by exact name, so some aliases are spelled out.
        "syntax": {
          "comment": { "color": "#8b8772" },
          "string": { "color": "#ced87f" },
          "keyword": { "color": "#ff0080" },
          "keyword.directive": { "color": "#a38c26" },
          "keyword.preproc": { "color": "#a38c26" },
          "preproc": { "color": "#a38c26" },
          "conditional": { "color": "#ff0080" },
          "repeat": { "color": "#ff0080" },
          "include": { "color": "#ff0080" },
          "import": { "color": "#ff0080" },
          "operator": { "color": "#ff0080" },
          "tag": { "color": "#ff0080" },
          "tag.component": { "color": "#fef93a" },
          "punctuation": { "color": "#c3c0b5" },

          "number": { "color": "#fe61fa" },
          "boolean": { "color": "#fe61fa" },
          "constant": { "color": "#fe61fa" },
          "constant.builtin": { "color": "#fe61fa" },
          "variant": { "color": "#fe61fa" },
          "type.unit": { "color": "#fe61fa" },

          "namespace": { "color": "#b7b7db" },
          "module": { "color": "#b7b7db" },
          "type": { "color": "#fef93a" },
          "type.definition": { "color": "#fef93a", "font_weight": 700 },
          "type.class.definition": { "color": "#fef93a", "font_weight": 700 },
          "constructor": { "color": "#fef93a" },
          "type.interface": { "color": "#00ff88" },
          "type.interface.definition": { "color": "#00ff88", "font_weight": 700 },
          "type.parameter": { "color": "#fe9732" },
          "type.parameter.definition": { "color": "#fe9732", "font_weight": 700 },
          "lifetime": { "color": "#fe9732" },
          "type.event": { "color": "#b0e0e6" },

          "function": { "color": "#54fe50" },
          "function.definition": { "color": "#54fe50", "font_weight": 700 },
          "function.macro": { "color": "#fe61fa" },
          "function.special": { "color": "#fe61fa" },
          "function.special.definition": { "color": "#fe61fa", "font_weight": 700 },
          "function.decorator": { "color": "#fe61fa" },
          "function.kwargs": { "color": "#57e6ff" },

          "variable": { "color": "#ff8040" },
          "variable.builtin": { "color": "#ff8040" },
          "variable.special": { "color": "#ff8040" },
          "variable.global": { "color": "#f53934", "font_style": "italic" },
          "variable.parameter": { "color": "#57e6ff" },
          "parameter": { "color": "#57e6ff" },
          "property": { "color": "#8d81fe" },
          "property.json_key": { "color": "#c3fc94" },
          "attribute": { "color": "#8d81fe" },
          "selector": { "color": "#8d81fe" },
          "label": { "color": "#ba55d3" },

          // Markup (Markdown) and diffs.
          "title": { "color": "#ba55d3" },
          "emphasis": { "color": "#ced87f" },
          "emphasis.strong": { "color": "#ced87f" },
          "link_text": { "color": "#57e6ff" },
          "link_uri": { "color": "#1e90ff" },
          "text.literal": { "color": "#8fbc8f" },
          "diff.plus": { "color": "#adff2f" },
          "diff.minus": { "color": "#dc143c" },
          "diff.delta": { "color": "#ffd700" },

          // Inlay hints and edit predictions.
          "hint": { "color": "#4f4f4f" },
          "predictive": { "color": "#767771", "font_style": "italic" }
        }
      }
    }
  ]
}
